<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>將 NUTC 學年行事曆加入您的 Apple 日曆</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>需要您的位置以在接近停車場時發送通知</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>需要您的位置以顯示附近的停車場</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- 僅對學校網域放行不安全的 HTTP（部分校內舊頁面），其餘一律要求 ATS 合規的 HTTPS。
             apps.nutc.edu.tw 的憑證鏈問題由 NUTCServerTrustDelegate 於 HTTPS 下處理，無需在此放行。 -->
        <key>NSExceptionDomains</key>
        <dict>
            <key>nutc.edu.tw</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
</dict>
</plist>
